<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <!-- Required for IDE0005 (unused usings) to run at build time. Public API docs are not mandatory. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <Authors>Gerald Versluis and contributors</Authors>
    <Copyright>Copyright (c) Gerald Versluis</Copyright>
    <RepositoryUrl>https://github.com/jfversluis/maui-gallery</RepositoryUrl>

    <!--
      The app version shown in the stores (ApplicationDisplayVersion). Bump it here for each release, and tag the
      release commit v<Version>. Use major.minor.patch only: the stores reject prerelease suffixes.
    -->
    <Version>1.0.0</Version>
  </PropertyGroup>
</Project>

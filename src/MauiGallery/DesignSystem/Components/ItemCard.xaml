<ContentView x:Class="MauiGallery.DesignSystem.Components.ItemCard"
             x:Name="Self"
             x:DataType="GalleryItem">
    <Border x:Name="CardBorder"
            Style="{StaticResource InteractiveCard}"
            Padding="16"
            AutomationId="{$'item-card-{Id}'}"
            SemanticProperties.Description="{Title}"
            SemanticProperties.Hint="{Description}">
        <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding Command, Source={x:Reference Self}, x:DataType=ItemCard}"
                                  CommandParameter="{Binding .}" />
        </Border.GestureRecognizers>
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
            <Border WidthRequest="40"
                    HeightRequest="40"
                    VerticalOptions="Start"
                    StrokeThickness="0"
                    StrokeShape="{StaticResource ShapeInput}"
                    BackgroundColor="{DynamicResource ColorAccentSubtle}">
                <Label Text="{IconGlyph}"
                       Style="{StaticResource TextIcon}"
                       TextColor="{DynamicResource ColorAccentText}" />
            </Border>
            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                <Label Text="{Binding FeaturedTask}"
                       Style="{StaticResource TextOverline}"
                       TextColor="{DynamicResource ColorAccentText}"
                       Margin="0,0,0,2"
                       IsVisible="{Binding ShowFeaturedTask, Source={x:Reference Self}, x:DataType=ItemCard}" />
                <Label Text="{Title}" Style="{StaticResource TextBodyStrong}" />
                <Label Text="{Description}"
                       Style="{StaticResource TextCaption}"
                       MaxLines="2"
                       LineBreakMode="TailTruncation" />
            </VerticalStackLayout>
        </Grid>
    </Border>
</ContentView>

<ContentView x:Class="MauiGallery.DesignSystem.Components.Chip"
             x:Name="Self"
             x:DataType="Chip">
    <Border x:Name="Pill"
            Padding="10,4"
            StrokeShape="{StaticResource ShapePill}"
            StrokeThickness="0"
            BackgroundColor="{DynamicResource ColorSurfaceAlt}">
        <HorizontalStackLayout Spacing="6">
            <Label x:Name="GlyphLabel"
                   Style="{StaticResource TextIcon}"
                   FontSize="14"
                   Text="{Binding Glyph, Source={x:Reference Self}}"
                   IsVisible="{Binding Glyph, Source={x:Reference Self}, Converter={StaticResource IsNotNullOrEmpty}}"
                   TextColor="{DynamicResource ColorTextSecondary}" />
            <Label x:Name="TextLabel"
                   Style="{StaticResource TextCaptionStrong}"
                   VerticalTextAlignment="Center"
                   Text="{Binding Text, Source={x:Reference Self}}" />
        </HorizontalStackLayout>
    </Border>
</ContentView>

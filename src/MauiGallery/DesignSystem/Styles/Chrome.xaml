<?xml version="1.0" encoding="utf-8" ?>
<!-- Keyed chrome styles. Never add implicit styles here: samples must render with platform defaults. -->
<ResourceDictionary x:Class="MauiGallery.DesignSystem.Styles.Chrome"
                    xmlns:behaviors="clr-namespace:MauiGallery.DesignSystem.Behaviors">

    <IsNotNullOrEmptyConverter x:Key="IsNotNullOrEmpty" />
    <RoundedConverter x:Key="Rounded" />
    <InvertedBoolConverter x:Key="InvertedBool" />

    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource FontMedium}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{DynamicResource ColorAccentText}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="MinimumHeightRequest" Value="{OnIdiom Phone=44, Default=32}" />
    </Style>

    <Style x:Key="PageChrome" TargetType="ContentPage">
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorBackground}" />
    </Style>

    <!-- Page body: centered, width-capped column whose padding grows with the window. -->
    <Style x:Key="PageContent" TargetType="VerticalStackLayout">
        <Setter Property="Spacing" Value="24" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="MaximumWidthRequest" Value="{StaticResource ContentMaxWidth}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="WindowWidth">
                    <VisualState x:Name="Compact">
                        <VisualState.Setters>
                            <!-- The bottom inset keeps the last controls clear of floating tab bars. -->
                            <Setter Property="Padding" Value="16,12,16,112" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Medium">
                        <VisualState.Setters>
                            <Setter Property="Padding" Value="32,24,32,48" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Expanded">
                        <VisualState.Setters>
                            <Setter Property="Padding" Value="48,32,48,64" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
        <!-- States follow the window width; see WindowSizeStates for why this is not an AdaptiveTrigger. -->
        <Setter Property="behaviors:WindowSizeStates.IsEnabled" Value="True" />
    </Style>

    <Style x:Key="OptionLabel" TargetType="Label" BasedOn="{StaticResource TextCaptionStrong}">
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorSurface}" />
        <Setter Property="Stroke" Value="{DynamicResource BrushOutline}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="{StaticResource ShapeCard}" />
        <Setter Property="Shadow" Value="{DynamicResource ShadowCard}" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <!-- A card that reacts to pointer hover and press, for navigation tiles. -->
    <Style x:Key="InteractiveCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="behaviors:Hover.Background" Value="ColorSurfaceAlt" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="0.98" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="SubtlePanel" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorSurfaceAlt}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="{StaticResource ShapeCard}" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="Divider" TargetType="BoxView">
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="Color" Value="{DynamicResource ColorOutline}" />
    </Style>

    <Style x:Key="AccentButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource FontSemiBold}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{DynamicResource ColorOnAccent}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorAccent}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="18,10" />
        <Setter Property="MinimumHeightRequest" Value="{OnIdiom Phone=44, Default=40}" />
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource FontSemiBold}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{DynamicResource ColorTextPrimary}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorSurface}" />
        <Setter Property="BorderColor" Value="{DynamicResource ColorOutlineStrong}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="18,10" />
        <Setter Property="MinimumHeightRequest" Value="{OnIdiom Phone=44, Default=40}" />
    </Style>

    <!-- Icon-only buttons in the chrome: page actions, copy, toolbar toggles. -->
    <Style x:Key="IconButton" TargetType="ImageButton">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="8" />
        <!-- Phones: 44 pt is Apple's minimum touch target, 48 dp is Android's. -->
        <Setter Property="WidthRequest" Value="{OnIdiom Phone={OnPlatform Android=48, Default=44}, Default=36}" />
        <Setter Property="HeightRequest" Value="{OnIdiom Phone={OnPlatform Android=48, Default=44}, Default=36}" />
        <Setter Property="behaviors:Hover.Background" Value="ColorSurfaceHover" />
    </Style>

    <!-- Buttons placed on the brand gradient. -->
    <Style x:Key="HeroButton" TargetType="Button" BasedOn="{StaticResource AccentButton}">
        <Setter Property="TextColor" Value="#2A1477" />
        <Setter Property="BackgroundColor" Value="#FFFFFF" />
    </Style>

    <Style x:Key="HeroSecondaryButton" TargetType="Button" BasedOn="{StaticResource AccentButton}">
        <Setter Property="TextColor" Value="#FFFFFF" />
        <Setter Property="BackgroundColor" Value="#33FFFFFF" />
        <Setter Property="BorderColor" Value="#66FFFFFF" />
        <Setter Property="BorderWidth" Value="1" />
    </Style>

</ResourceDictionary>

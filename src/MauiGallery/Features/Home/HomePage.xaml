<ContentPage x:Class="MauiGallery.Features.Home.HomePage"
             x:DataType="HomeViewModel"
             Title="Home"
             Style="{StaticResource PageChrome}">
    <ScrollView>
        <VerticalStackLayout x:Name="Sections" Style="{StaticResource PageContent}" Spacing="40">

            <!-- Hero -->
            <Border x:Name="Hero"
                    Background="{DynamicResource BrushHero}"
                    StrokeThickness="0"
                    StrokeShape="{StaticResource ShapeHero}"
                    Shadow="{DynamicResource ShadowRaised}"
                    Padding="28,32">
                <Grid x:Name="HeroGrid" ColumnSpacing="40" RowSpacing="28">
                    <VerticalStackLayout x:Name="HeroText" Spacing="16" VerticalOptions="Center">
                        <Label Text=".NET MAUI GALLERY"
                               Style="{StaticResource TextOverline}"
                               TextColor="#D9D2FF" />
                        <Label x:Name="HeroTitle"
                               Text="One codebase. Truly native."
                               Style="{StaticResource TextDisplay}"
                               TextColor="White" />
                        <Label x:Name="HeroBody"
                               Text="{x:Static HomePage.HeroCopy}"
                               Style="{StaticResource TextBody}"
                               FontSize="16"
                               TextColor="#EDE9FF" />
                        <FlexLayout Wrap="Wrap" Margin="0,8,0,0">
                            <Button Text="Browse controls"
                                    Style="{StaticResource HeroButton}"
                                    Command="{Binding BrowseControlsCommand}"
                                    Margin="0,0,12,8"
                                    AutomationId="home-browse" />
                            <Button Text="Get started"
                                    Style="{StaticResource HeroSecondaryButton}"
                                    Command="{Binding OpenLinkCommand}"
                                    CommandParameter="{Binding GetStarted[0]}"
                                    Margin="0,0,12,8"
                                    AutomationId="home-get-started" />
                        </FlexLayout>
                    </VerticalStackLayout>

                    <!-- Live native controls, with the platform type each one became -->
                    <Border x:Name="HeroShowcase"
                            BackgroundColor="{DynamicResource ColorStage}"
                            StrokeThickness="0"
                            StrokeShape="{StaticResource ShapeCard}"
                            Padding="0"
                            VerticalOptions="Center">
                        <Grid>
                            <DotGridView DotColor="{DynamicResource ColorStageDot}" />
                            <VerticalStackLayout x:Name="ShowcaseItems" Padding="24,20" Spacing="18">
                                <Label Text="These are real native controls"
                                       Style="{StaticResource TextCaptionStrong}" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <NativeViewBadge Target="{x:Reference ShowcaseSwitch}" HorizontalOptions="Start" VerticalOptions="Center" />
                                    <Switch x:Name="ShowcaseSwitch" Grid.Column="1" IsToggled="True" SemanticProperties.Description="Native switch" />
                                </Grid>
                                <VerticalStackLayout Spacing="8">
                                    <NativeViewBadge Target="{x:Reference ShowcaseSlider}" HorizontalOptions="Start" />
                                    <Slider x:Name="ShowcaseSlider" Value="0.6" SemanticProperties.Description="Native slider" />
                                </VerticalStackLayout>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <NativeViewBadge Target="{x:Reference ShowcaseButton}" HorizontalOptions="Start" VerticalOptions="Center" />
                                    <Button x:Name="ShowcaseButton" Grid.Column="1" Text="Button" />
                                </Grid>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Recently visited -->
            <VerticalStackLayout Spacing="12" IsVisible="{HasRecents}">
                <SectionHeader Title="Continue exploring" />
                <AdaptiveGrid MinItemWidth="260" BindableLayout.ItemsSource="{Recents}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="GalleryItem">
                            <ItemCard Command="{Binding OpenItemCommand, Source={RelativeSource AncestorType={x:Type HomeViewModel}}, x:DataType=HomeViewModel}" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </AdaptiveGrid>
            </VerticalStackLayout>
            <!-- Favorites -->
            <VerticalStackLayout Spacing="12" IsVisible="{HasFavorites}">
                <SectionHeader Title="Favorites" />
                <AdaptiveGrid MinItemWidth="260" BindableLayout.ItemsSource="{Favorites}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="GalleryItem">
                            <ItemCard Command="{Binding OpenItemCommand, Source={RelativeSource AncestorType={x:Type HomeViewModel}}, x:DataType=HomeViewModel}" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </AdaptiveGrid>
            </VerticalStackLayout>
            <!-- Further down the page: created once the page is on screen, so its first frame comes sooner. -->
            <!-- Featured -->
            <DeferredView IsVisible="{HasFeatured}">
                <DataTemplate x:DataType="HomeViewModel">
                    <VerticalStackLayout Spacing="12">
                        <SectionHeader Title="Start here" />
                        <AdaptiveGrid MinItemWidth="260" BindableLayout.ItemsSource="{Featured}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="GalleryItem">
                                    <ItemCard ShowFeaturedTask="True" Command="{Binding OpenItemCommand, Source={RelativeSource AncestorType={x:Type HomeViewModel}}, x:DataType=HomeViewModel}" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </AdaptiveGrid>
                    </VerticalStackLayout>
                </DataTemplate>
            </DeferredView>
            <!-- Categories -->
            <DeferredView>
                <DataTemplate x:DataType="HomeViewModel">
                    <VerticalStackLayout Spacing="12">
                        <SectionHeader Title="Browse by category" ActionText="All controls" Command="{Binding BrowseControlsCommand}" />
                        <AdaptiveGrid MinItemWidth="240" BindableLayout.ItemsSource="{Categories}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="CategoryTile">
                                    <Border Style="{StaticResource InteractiveCard}"
                                            AutomationId="{$'category-{Category.Id}'}"
                                            SemanticProperties.Description="{Category.Title}"
                                            SemanticProperties.Hint="{Category.Description}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding OpenCategoryCommand, Source={RelativeSource AncestorType={x:Type HomeViewModel}}, x:DataType=HomeViewModel}"
                                                                  CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <VerticalStackLayout Spacing="12">
                                            <Border WidthRequest="44"
                                                    HeightRequest="44"
                                                    HorizontalOptions="Start"
                                                    StrokeThickness="0"
                                                    StrokeShape="{StaticResource ShapeCard}"
                                                    Background="{DynamicResource BrushHero}">
                                                <Label Text="{Category.IconGlyph}" Style="{StaticResource TextIcon}" TextColor="White" />
                                            </Border>
                                            <VerticalStackLayout Spacing="4">
                                                <Label Text="{Category.Title}" Style="{StaticResource TextBodyStrong}" FontSize="16" />
                                                <Label Text="{Category.Description}" Style="{StaticResource TextCaption}" />
                                            </VerticalStackLayout>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <Label Text="{CountText}" Style="{StaticResource TextCaption}" VerticalOptions="Center" />
                                                <Label Grid.Column="1"
                                                       Text="{x:Static FluentIconsRegular.ChevronRight24}"
                                                       Style="{StaticResource TextIcon}"
                                                       FontSize="{StaticResource IconSizeSmall}"
                                                       TextColor="{DynamicResource ColorTextTertiary}" />
                                            </Grid>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </AdaptiveGrid>
                    </VerticalStackLayout>
                </DataTemplate>
            </DeferredView>
            <!-- Get started -->
            <DeferredView>
                <DataTemplate x:DataType="HomeViewModel">
                    <VerticalStackLayout Spacing="12">
                        <SectionHeader Title="Get started" />
                        <AdaptiveGrid MinItemWidth="240" BindableLayout.ItemsSource="{GetStarted}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="GetStartedLink">
                                    <Border Style="{StaticResource InteractiveCard}"
                                            Padding="16"
                                            SemanticProperties.Description="{.Title}"
                                            SemanticProperties.Hint="{Description}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding OpenLinkCommand, Source={RelativeSource AncestorType={x:Type HomeViewModel}}, x:DataType=HomeViewModel}"
                                                                  CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                            <Label Text="{IconGlyph}"
                                                   Style="{StaticResource TextIcon}"
                                                   FontSize="{StaticResource IconSizeLarge}"
                                                   TextColor="{DynamicResource ColorAccentText}"
                                                   VerticalOptions="Start" />
                                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                <Label Text="{.Title}" Style="{StaticResource TextBodyStrong}" />
                                                <Label Text="{Description}" Style="{StaticResource TextCaption}" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="2"
                                                   Text="{x:Static FluentIconsRegular.Open24}"
                                                   Style="{StaticResource TextIcon}"
                                                   FontSize="{StaticResource IconSizeSmall}"
                                                   TextColor="{DynamicResource ColorTextTertiary}"
                                                   VerticalOptions="Start" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </AdaptiveGrid>
                    </VerticalStackLayout>
                </DataTemplate>
            </DeferredView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

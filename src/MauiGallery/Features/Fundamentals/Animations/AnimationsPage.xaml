<SamplePage x:Class="MauiGallery.Features.Fundamentals.AnimationsPage"
            xmlns:icons="clr-namespace:IconFont.Maui.FluentIcons;assembly=IconFont.Maui.FluentIcons"
            x:DataType="SamplePageViewModel">
    <SamplePage.Resources>
        <x:Array x:Key="AnimationOptions" Type="{x:Type x:String}">
            <x:String>FadeToAsync</x:String>
            <x:String>ScaleToAsync</x:String>
            <x:String>RotateToAsync</x:String>
            <x:String>RotateYToAsync</x:String>
            <x:String>TranslateToAsync</x:String>
        </x:Array>
        <x:Array x:Key="EasingOptions" Type="{x:Type x:String}">
            <x:String>Linear</x:String>
            <x:String>SinIn</x:String>
            <x:String>SinOut</x:String>
            <x:String>SinInOut</x:String>
            <x:String>CubicIn</x:String>
            <x:String>CubicOut</x:String>
            <x:String>CubicInOut</x:String>
            <x:String>BounceIn</x:String>
            <x:String>BounceOut</x:String>
            <x:String>SpringIn</x:String>
            <x:String>SpringOut</x:String>
        </x:Array>
        <Style x:Key="AnimatedCard" TargetType="Border">
            <Setter Property="WidthRequest" Value="120" />
            <Setter Property="HeightRequest" Value="80" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        </Style>
        <Style x:Key="CardText" TargetType="Label">
            <Setter Property="TextColor" Value="White" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="HorizontalOptions" Value="Center" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
    </SamplePage.Resources>

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PageContent}">
            <ControlPageHeader />

            <!-- 1. One property -->
            <ControlExample x:Name="BasicExample"
                            Title="Animate a property"
                            Description="FadeToAsync, ScaleToAsync, RotateToAsync, TranslateToAsync and their siblings animate one property of any view to a target value over a length in milliseconds, following an easing curve. MAUI honors the system's reduce motion setting: when it's on, animations jump straight to their end value."
                            XamlSource="AnimationsBasic.xaml.txt"
                            CSharpSource="AnimationsBasic.cs.txt">
                <VerticalStackLayout Spacing="24" WidthRequest="240">
                    <Border x:Name="BasicCard"
                            Style="{StaticResource AnimatedCard}"
                            BackgroundColor="#512BD4"
                            AutomationId="sample-animation-card">
                        <Label Text="MAUI" Style="{StaticResource CardText}" />
                    </Border>
                    <Button Text="Play"
                            HorizontalOptions="Center"
                            Clicked="OnBasicPlayClicked"
                            AutomationId="sample-animation-play" />
                </VerticalStackLayout>
                <ControlExample.Options>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Animation" Style="{StaticResource OptionLabel}" />
                        <Picker x:Name="BasicAnimation"
                                ItemsSource="{StaticResource AnimationOptions}"
                                SelectedIndex="0"
                                SelectedIndexChanged="OnBasicOptionChanged"
                                AutomationId="option-animation-method" />
                        <Label Text="Easing" Style="{StaticResource OptionLabel}" />
                        <Picker x:Name="BasicEasing"
                                ItemsSource="{StaticResource EasingOptions}"
                                SelectedIndex="6"
                                SelectedIndexChanged="OnBasicOptionChanged"
                                AutomationId="option-animation-easing" />
                        <Label Text="{Binding Value, Source={x:Reference BasicLength}, StringFormat='Length: {0:0} ms', x:DataType=Slider}"
                               Style="{StaticResource OptionLabel}" />
                        <Slider x:Name="BasicLength"
                                Minimum="100"
                                Maximum="2000"
                                Value="600"
                                ValueChanged="OnBasicOptionChanged"
                                AutomationId="option-animation-length" />
                    </VerticalStackLayout>
                </ControlExample.Options>
                <ControlExample.Substitutions>
                    <Substitution x:Name="BasicForward" Key="Forward" IsExpression="True" />
                    <Substitution x:Name="BasicBack" Key="Back" IsExpression="True" />
                </ControlExample.Substitutions>
            </ControlExample>

            <!-- 2. Together or in sequence -->
            <ControlExample x:Name="CompositeExample"
                            Title="Run animations together or in sequence"
                            Description="Every animation method returns a task. Start several and await Task.WhenAll to run them at the same time, or await them one by one to play them in sequence. Animations of different properties can run on the same view at once."
                            XamlSource="AnimationsComposite.xaml.txt"
                            CSharpSource="AnimationsComposite.cs.txt">
                <VerticalStackLayout Spacing="24" WidthRequest="240">
                    <Border x:Name="CompositeCard"
                            Style="{StaticResource AnimatedCard}"
                            BackgroundColor="#0D9488"
                            AutomationId="sample-composite-card">
                        <Label Text="MAUI" Style="{StaticResource CardText}" />
                    </Border>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Text="Together" Clicked="OnTogetherClicked" AutomationId="sample-composite-together" />
                        <Button Grid.Column="1" Text="In sequence" Clicked="OnSequenceClicked" AutomationId="sample-composite-sequence" />
                    </Grid>
                </VerticalStackLayout>
            </ControlExample>

            <!-- 3. Custom Animation -->
            <ControlExample x:Name="CustomExample"
                            Title="Build a custom animation"
                            Description="An Animation calls you back with values between a start and an end, so it can drive any property. Add child animations that each run over part of the parent's timeline, from 0 to 1, then Commit it to a view with a name, a length and an optional repeat."
                            ShowStyleToggle="False"
                            XamlSource="AnimationsCustom.xaml.txt"
                            CSharpSource="AnimationsCustom.cs.txt">
                <VerticalStackLayout Spacing="16" WidthRequest="240">
                    <Label x:Name="Heart"
                           Text="{x:Static icons:FluentIconsFilled.Heart48}"
                           FontFamily="{x:Static icons:FluentIconsFilled.FontFamily}"
                           FontSize="72"
                           TextColor="#DB2777"
                           HorizontalOptions="Center"
                           SemanticProperties.Description="Heart"
                           AutomationId="sample-custom-heart" />
                    <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Button Text="Beat" Clicked="OnBeatClicked" AutomationId="sample-custom-beat" />
                        <Button Text="Stop" Clicked="OnBeatStopClicked" AutomationId="sample-custom-stop" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
                <ControlExample.Options>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{Binding Value, Source={x:Reference CustomLength}, StringFormat='Length: {0:0} ms', x:DataType=Slider}"
                               Style="{StaticResource OptionLabel}" />
                        <Slider x:Name="CustomLength"
                                Minimum="400"
                                Maximum="2000"
                                Value="1000"
                                AutomationId="option-custom-length" />
                        <Label Text="Repeat" Style="{StaticResource OptionLabel}" />
                        <Switch x:Name="CustomRepeat" IsToggled="True" AutomationId="option-custom-repeat" />
                    </VerticalStackLayout>
                </ControlExample.Options>
                <ControlExample.Substitutions>
                    <Substitution Key="Length" Value="{Binding Value, Source={x:Reference CustomLength}, x:DataType=Slider, Converter={StaticResource Rounded}}" />
                    <Substitution Key="Repeat" Value="{Binding IsToggled, Source={x:Reference CustomRepeat}, x:DataType=Switch}" Default="False" IsExpression="True" />
                </ControlExample.Substitutions>
            </ControlExample>

            <!-- 4. Cancel -->
            <ControlExample x:Name="CancelExample"
                            Title="Stop a running animation"
                            Description="Pass a CancellationToken to stop the animations you started, or call CancelAnimations to stop every animation on a view. A stopped animation leaves the view where it is and its task returns true, which ends this endless bounce loop."
                            XamlSource="AnimationsCancel.xaml.txt"
                            CSharpSource="AnimationsCancel.cs.txt">
                <VerticalStackLayout Spacing="16" WidthRequest="{OnIdiom Phone=280, Default=320}">
                    <Grid HeightRequest="120">
                        <BoxView HeightRequest="1"
                                 VerticalOptions="End"
                                 Color="{AppThemeBinding Light=#AEAEB2, Dark=#636366}" />
                        <Ellipse x:Name="Ball"
                                 WidthRequest="40"
                                 HeightRequest="40"
                                 Fill="#EA580C"
                                 VerticalOptions="End"
                                 HorizontalOptions="Center"
                                 AutomationId="sample-cancel-ball" />
                    </Grid>
                    <Button Text="Bounce" HorizontalOptions="Center" Clicked="OnBounceClicked" AutomationId="sample-cancel-start" />
                    <FlexLayout Wrap="Wrap" JustifyContent="Center">
                        <Button Text="Cancel token" Margin="4" FlexLayout.Shrink="0" Clicked="OnCancelTokenClicked" AutomationId="sample-cancel-token" />
                        <Button Text="CancelAnimations" Margin="4" FlexLayout.Shrink="0" Clicked="OnCancelAnimationsClicked" AutomationId="sample-cancel-all" />
                    </FlexLayout>
                </VerticalStackLayout>
            </ControlExample>

            <RelatedItems />
        </VerticalStackLayout>
    </ScrollView>
</SamplePage>

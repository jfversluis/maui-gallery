<h1>Hello from Razor</h1>
<p>This component runs on .NET, in the app's process, and renders HTML into the web view.</p>

<button class="primary" @onclick="IncrementCount">Clicked @count @(count == 1 ? "time" : "times")</button>

@code {
    private int count;

    private void IncrementCount() => count++;
}

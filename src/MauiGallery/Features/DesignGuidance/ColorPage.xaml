<SamplePage x:Class="MauiGallery.Features.DesignGuidance.ColorPage"
            xmlns:local="clr-namespace:MauiGallery.Features.DesignGuidance"
            x:DataType="SamplePageViewModel">
    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PageContent}">
            <ControlPageHeader />
            <local:ColorPalette x:Name="Palette" IsVisible="False" />

            <Border Style="{StaticResource SubtlePanel}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Branded chrome, native stage" Style="{StaticResource TextBodyStrong}" />
                    <Label Style="{StaticResource TextBodySecondary}"
                           Text="This app's colors style its own navigation, cards and code viewer. Samples sit on a neutral stage and keep their platform colors, so you see exactly what each platform gives you. Every token below has a light and a dark value; switch themes in Settings and watch them change." />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Groups, Source={x:Reference Palette}, x:DataType=local:ColorPalette}" Spacing="24">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="local:ColorTokenGroup">
                        <VerticalStackLayout Spacing="12">
                            <SectionHeader Title="{Binding Title}" />
                            <AdaptiveGrid MinItemWidth="220" BindableLayout.ItemsSource="{Binding Tokens}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="local:ColorToken">
                                        <Border Style="{StaticResource Card}" Padding="12">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                                <Border WidthRequest="44"
                                                        HeightRequest="44"
                                                        StrokeShape="{StaticResource ShapeInput}"
                                                        Stroke="{DynamicResource BrushOutline}"
                                                        BackgroundColor="{Binding Color}" />
                                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                                    <Label Text="{Binding Name}" Style="{StaticResource TextBodyStrong}" FontSize="14" />
                                                    <Label Text="{Binding Hex}" Style="{StaticResource TextCode}" FontSize="12" TextColor="{DynamicResource ColorTextSecondary}" />
                                                </VerticalStackLayout>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </AdaptiveGrid>
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <ControlExample Title="Colors that follow the theme"
                            Description="Use AppThemeBinding for one-off values. For a design system, give each token the same key in a light and a dark dictionary and reference it with DynamicResource, as this app does."
                            XamlSource="ColorTheme.xaml.txt"
                            CSharpSource="ColorTheme.cs.txt">
                <Label Text="Hello, themes!"
                       FontSize="24"
                       TextColor="{AppThemeBinding Light=#512BD4, Dark=#B3A3FF}" />
            </ControlExample>

            <RelatedItems />
        </VerticalStackLayout>
    </ScrollView>
</SamplePage>

<SamplePage x:Class="MauiGallery.Features.PlatformApis.HapticsAndVibrationPage"
            x:DataType="SamplePageViewModel">
    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PageContent}">
            <ControlPageHeader />

            <!-- 1. Haptic feedback -->
            <ControlExample x:Name="HapticExample"
                            Title="Haptic feedback"
                            ShowNativeBadge="False"
                            ShowStyleToggle="False"
                            ShowRtlToggle="False"
                            Description="HapticFeedback.Perform plays the short tap the platform uses for its own controls: Click for a confirmation, LongPress for a press-and-hold. It respects the user's system settings. Phones support it; check IsSupported elsewhere."
                            CSharpSource="HapticsPerform.cs.txt">
                <VerticalStackLayout x:Name="HapticSample"
                                     x:DataType="HapticsViewModel"
                                     Spacing="12">
                    <HorizontalStackLayout Spacing="12" HorizontalOptions="Center">
                        <Button x:Name="HapticClick"
                                Text="Click"
                                Command="{Binding PerformCommand}"
                                CommandParameter="Click"
                                AutomationId="sample-haptics-click" />
                        <Button Text="LongPress"
                                Command="{Binding PerformCommand}"
                                CommandParameter="LongPress"
                                AutomationId="sample-haptics-long-press" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </ControlExample>

            <!-- 2. Haptics on your own control -->
            <ControlExample x:Name="DialExample"
                            Title="Add a feel to your own controls"
                            ShowNativeBadge="False"
                            ShowStyleToggle="False"
                            ShowRtlToggle="False"
                            Description="Built-in controls play their own haptics; custom ones don't. Perform a Click on each meaningful change, here every whole step of a slider, and it feels like a dial with notches. Keep haptics subtle and tied to what the user does."
                            XamlSource="HapticsDial.xaml.txt"
                            CSharpSource="HapticsDial.cs.txt">
                <VerticalStackLayout x:Name="DialSample"
                                     x:DataType="HapticsViewModel"
                                     Spacing="8"
                                     WidthRequest="{OnIdiom Phone=260, Default=320}">
                    <Label Text="{$'Level {Step}'}"
                           FontSize="20"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           AutomationId="sample-haptics-level" />
                    <Slider x:Name="DialSlider"
                            Minimum="0"
                            Maximum="10"
                            Value="{Level}"
                            SemanticProperties.Description="Level"
                            AutomationId="sample-haptics-slider" />
                </VerticalStackLayout>
                <ControlExample.Options>
                    <Grid x:Name="DialOptions" x:DataType="HapticsViewModel" ColumnDefinitions="*,Auto">
                        <Label Text="Haptics" Style="{StaticResource OptionLabel}" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{UseHaptics}" AutomationId="option-haptics-enabled" />
                    </Grid>
                </ControlExample.Options>
            </ControlExample>

            <!-- 3. Vibration -->
            <ControlExample x:Name="VibrationExample"
                            Title="Vibration"
                            ShowNativeBadge="False"
                            ShowStyleToggle="False"
                            ShowRtlToggle="False"
                            Description="Vibration.Vibrate runs the vibration motor for as long as you ask, and Cancel stops it early. Use it for alerts the user must notice, not as feedback on every touch. iOS always vibrates for about half a second, whatever the duration. Android needs the VIBRATE permission in AndroidManifest.xml."
                            CSharpSource="HapticsVibrate.cs.txt">
                <VerticalStackLayout x:Name="VibrationSample"
                                     x:DataType="HapticsViewModel"
                                     Spacing="12">
                    <HorizontalStackLayout Spacing="12" HorizontalOptions="Center">
                        <Button x:Name="VibrateButton"
                                Text="Vibrate"
                                Command="{Binding VibrateCommand}"
                                AutomationId="sample-vibration-vibrate" />
                        <Button Text="Cancel"
                                Command="{Binding CancelCommand}"
                                AutomationId="sample-vibration-cancel" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
                <ControlExample.Options>
                    <VerticalStackLayout x:Name="VibrationOptions" x:DataType="HapticsViewModel" Spacing="8">
                        <Label Text="{$'Duration: {DurationMilliseconds:0} ms'}" Style="{StaticResource OptionLabel}" />
                        <Slider x:Name="VibrationDuration"
                                Minimum="100"
                                Maximum="3000"
                                Value="{DurationMilliseconds}"
                                AutomationId="option-vibration-duration" />
                    </VerticalStackLayout>
                </ControlExample.Options>
                <ControlExample.Substitutions>
                    <Substitution Key="Duration" Value="{Binding Value, Source={x:Reference VibrationDuration}, x:DataType=Slider, Converter={StaticResource Rounded}}" />
                </ControlExample.Substitutions>
            </ControlExample>

            <RelatedItems />
        </VerticalStackLayout>
    </ScrollView>
</SamplePage>

<SamplePage x:Class="MauiGallery.Features.PlatformApis.VersionTrackingPage"
            x:DataType="SamplePageViewModel">
    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PageContent}">
            <ControlPageHeader />

            <!-- 1. This launch -->
            <ControlExample x:Name="LaunchExample"
                            Title="Is this the first launch?"
                            ShowNativeBadge="False"
                            ShowStyleToggle="False"
                            ShowRtlToggle="False"
                            Description="VersionTracking remembers every version and build of your app that has run on the device. The first-launch flags drive onboarding the first time someone opens the app, and a what's-new screen after an update."
                            Notice="Call UseVersionTracking at startup, so the current launch is recorded before anything reads it."
                            XamlSource="VersionTrackingLaunch.xaml.txt"
                            CSharpSource="VersionTrackingLaunch.cs.txt">
                <VerticalStackLayout x:Name="LaunchSample"
                                     x:DataType="VersionTrackingViewModel"
                                     Spacing="16"
                                     WidthRequest="{OnIdiom Phone=280, Default=380}">
                    <Label Text="{Welcome}" FontSize="20" FontAttributes="Bold" AutomationId="sample-version-welcome" />
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="8">
                        <Label Text="First launch ever" Opacity="0.7" />
                        <Label Grid.Column="1" Text="{IsFirstLaunchEver}" AutomationId="sample-version-first-ever" />
                        <Label Grid.Row="1" Text="First for version" Opacity="0.7" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{IsFirstLaunchForCurrentVersion}" AutomationId="sample-version-first-version" />
                        <Label Grid.Row="2" Text="First for build" Opacity="0.7" />
                        <Label Grid.Row="2" Grid.Column="1" Text="{IsFirstLaunchForCurrentBuild}" />
                        <Label Grid.Row="3" Text="Current version" Opacity="0.7" />
                        <Label Grid.Row="3" Grid.Column="1" Text="{CurrentVersion}" AutomationId="sample-version-current" />
                        <Label Grid.Row="4" Text="Current build" Opacity="0.7" />
                        <Label Grid.Row="4" Grid.Column="1" Text="{CurrentBuild}" />
                    </Grid>
                </VerticalStackLayout>
            </ControlExample>

            <!-- 2. History -->
            <ControlExample x:Name="HistoryExample"
                            Title="Version history"
                            ShowNativeBadge="False"
                            ShowStyleToggle="False"
                            ShowRtlToggle="False"
                            Description="PreviousVersion is the version that ran before this one, which tells you which data to migrate after an update. FirstInstalledVersion and VersionHistory show how long someone has used the app, without your own bookkeeping. The history lives in the app's preferences, so it starts over after a reinstall."
                            XamlSource="VersionTrackingHistory.xaml.txt"
                            CSharpSource="VersionTrackingHistory.cs.txt">
                <VerticalStackLayout x:Name="HistorySample"
                                     x:DataType="VersionTrackingViewModel"
                                     Spacing="16"
                                     WidthRequest="{OnIdiom Phone=280, Default=380}">
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="8">
                        <Label Text="Previous version" Opacity="0.7" />
                        <Label Grid.Column="1" Text="{PreviousVersion}" AutomationId="sample-version-previous" />
                        <Label Grid.Row="1" Text="Previous build" Opacity="0.7" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{PreviousBuild}" />
                        <Label Grid.Row="2" Text="First installed" Opacity="0.7" />
                        <Label Grid.Row="2" Grid.Column="1" Text="{FirstInstalledVersion}" AutomationId="sample-version-first-installed" />
                        <Label Grid.Row="3" Text="First build" Opacity="0.7" />
                        <Label Grid.Row="3" Grid.Column="1" Text="{FirstInstalledBuild}" />
                        <Label Grid.Row="4" Text="Versions" Opacity="0.7" />
                        <Label Grid.Row="4" Grid.Column="1" Text="{VersionHistory}" AutomationId="sample-version-history" />
                        <Label Grid.Row="5" Text="Builds" Opacity="0.7" />
                        <Label Grid.Row="5" Grid.Column="1" Text="{BuildHistory}" />
                    </Grid>
                    <Label Text="{VersionCheck}" FontAttributes="Bold" AutomationId="sample-version-check" />
                </VerticalStackLayout>
                <ControlExample.Options>
                    <VerticalStackLayout x:Name="HistoryOptions" x:DataType="VersionTrackingViewModel" Spacing="8">
                        <Label Text="Look up a version" Style="{StaticResource OptionLabel}" />
                        <Entry x:Name="HistoryVersion" Text="{VersionToCheck}" AutomationId="option-version-check" />
                    </VerticalStackLayout>
                </ControlExample.Options>
                <ControlExample.Substitutions>
                    <Substitution Key="Version" Value="{Binding Text, Source={x:Reference HistoryVersion}, x:DataType=Entry}" />
                </ControlExample.Substitutions>
            </ControlExample>

            <RelatedItems />
        </VerticalStackLayout>
    </ScrollView>
</SamplePage>

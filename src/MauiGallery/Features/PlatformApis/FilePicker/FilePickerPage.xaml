<SamplePage x:Class="MauiGallery.Features.PlatformApis.FilePickerPage"
            xmlns:local="clr-namespace:MauiGallery.Features.PlatformApis"
            x:DataType="SamplePageViewModel">
    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PageContent}">
            <ControlPageHeader />

            <!-- 1. Pick a file -->
            <ControlExample x:Name="PickExample"
                            Title="Pick a file"
                            ShowNativeBadge="False"
                            ShowStyleToggle="False"
                            ShowRtlToggle="False"
                            Description="FilePicker.PickAsync opens the system's file browser and returns the file the person chose, or null if they cancel. FileTypes limits the choice: use the built-in Images, Pdf and Videos types, or name the types per platform, such as UTIs on iOS and Mac, MIME types on Android and extensions on Windows. Read the file with OpenReadAsync."
                            XamlSource="FilePickerPick.xaml.txt"
                            CSharpSource="FilePickerPick.cs.txt">
                <VerticalStackLayout x:Name="PickSample"
                                     x:DataType="local:FilePickerViewModel"
                                     Spacing="12"
                                     WidthRequest="{OnIdiom Phone=280, Default=380}">
                    <Button x:Name="PickButton"
                            Text="Choose a file"
                            Command="{Binding PickCommand}"
                            HorizontalOptions="Start"
                            AutomationId="sample-filepicker-pick" />
                    <Label Text="{Binding Status}" AutomationId="sample-filepicker-status" />
                    <Grid ColumnDefinitions="Auto,*"
                          RowDefinitions="Auto,Auto,Auto"
                          ColumnSpacing="16"
                          RowSpacing="8"
                          IsVisible="{Binding FileName, Converter={StaticResource IsNotNullOrEmpty}}">
                        <Label Text="Name" Opacity="0.7" />
                        <Label Grid.Column="1" Text="{Binding FileName}" AutomationId="sample-filepicker-name" />
                        <Label Grid.Row="1" Text="Type" Opacity="0.7" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding ContentType}" />
                        <Label Grid.Row="2" Text="Size" Opacity="0.7" />
                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding Size}" />
                    </Grid>
                    <Image Source="{Binding ImagePreview}"
                           HeightRequest="160"
                           Aspect="AspectFit"
                           HorizontalOptions="Start"
                           IsVisible="{Binding ImagePreview, Converter={StaticResource IsNotNullOrEmpty}}"
                           SemanticProperties.Description="Preview of the picked image"
                           AutomationId="sample-filepicker-image" />
                    <Label Text="{Binding TextPreview}"
                           FontSize="13"
                           IsVisible="{Binding TextPreview, Converter={StaticResource IsNotNullOrEmpty}}"
                           AutomationId="sample-filepicker-text" />
                </VerticalStackLayout>
                <ControlExample.Options>
                    <VerticalStackLayout x:Name="PickTypeOptions" x:DataType="local:FilePickerViewModel" Spacing="8">
                        <Label Text="FileTypes" Style="{StaticResource OptionLabel}" />
                        <Picker x:Name="PickType"
                                ItemsSource="{x:Static local:FilePickerViewModel.FileTypeNames}"
                                SelectedItem="{Binding FileTypeName}"
                                AutomationId="option-filepicker-type" />
                    </VerticalStackLayout>
                </ControlExample.Options>
                <ControlExample.Substitutions>
                    <Substitution x:Name="FileTypesSubstitution" Key="FileTypes" IsExpression="True" />
                </ControlExample.Substitutions>
            </ControlExample>

            <!-- 2. Pick several -->
            <ControlExample x:Name="MultipleExample"
                            Title="Pick several files"
                            ShowNativeBadge="False"
                            ShowStyleToggle="False"
                            ShowRtlToggle="False"
                            Description="PickMultipleAsync lets people choose more than one file at a time, for example to attach photos. It returns an empty list when they cancel."
                            XamlSource="FilePickerMultiple.xaml.txt"
                            CSharpSource="FilePickerMultiple.cs.txt">
                <VerticalStackLayout x:Name="MultipleSample"
                                     x:DataType="local:FilePickerViewModel"
                                     Spacing="12"
                                     WidthRequest="{OnIdiom Phone=280, Default=380}">
                    <Button x:Name="MultipleButton"
                            Text="Choose images"
                            Command="{Binding PickImagesCommand}"
                            HorizontalOptions="Start"
                            AutomationId="sample-filepicker-multiple" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding PickedFiles}" Spacing="4" AutomationId="sample-filepicker-files">
                        <BindableLayout.EmptyView>
                            <Label Text="No images picked" Opacity="0.7" />
                        </BindableLayout.EmptyView>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Label Text="{Binding .}" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ControlExample>

            <!-- 3. Save and open -->
            <ControlExample x:Name="SaveExample"
                            Title="Save a file and open it"
                            ShowNativeBadge="False"
                            ShowStyleToggle="False"
                            ShowRtlToggle="False"
                            Description=".NET MAUI has no save dialog. Save files your app owns in FileSystem.AppDataDirectory, which is private to the app and backed up, then hand one to another app with Launcher.OpenAsync and an OpenFileRequest. To let people choose where a file goes, the .NET MAUI Community Toolkit has a FileSaver."
                            XamlSource="FilePickerSave.xaml.txt"
                            CSharpSource="FilePickerSave.cs.txt">
                <VerticalStackLayout Spacing="12" WidthRequest="{OnIdiom Phone=280, Default=380}">
                    <Editor x:Name="SaveContents"
                            Text="Ideas&#10;- A dark mode&#10;- More samples"
                            HeightRequest="90"
                            SemanticProperties.Description="File contents"
                            AutomationId="sample-filepicker-save-contents" />
                    <HorizontalStackLayout Spacing="8">
                        <Button x:Name="SaveButton" Text="Save" Clicked="OnSaveClicked" AutomationId="sample-filepicker-save" />
                        <Button x:Name="OpenButton" Text="Open" Clicked="OnOpenClicked" IsEnabled="False" AutomationId="sample-filepicker-open" />
                    </HorizontalStackLayout>
                    <Label x:Name="SaveStatus" Text="Not saved yet" AutomationId="sample-filepicker-save-status" />
                </VerticalStackLayout>
                <ControlExample.Options>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="File name" Style="{StaticResource OptionLabel}" />
                        <Entry x:Name="SaveName" Text="ideas.txt" AutomationId="option-filepicker-save-name" />
                    </VerticalStackLayout>
                </ControlExample.Options>
                <ControlExample.Substitutions>
                    <Substitution Key="FileName" Value="{Binding Text, Source={x:Reference SaveName}, x:DataType=Entry}" />
                </ControlExample.Substitutions>
            </ControlExample>

            <RelatedItems />
        </VerticalStackLayout>
    </ScrollView>
</SamplePage>

<SamplePage x:Class="MauiGallery.Features.PlatformApis.ConnectivityPage"
            xmlns:local="clr-namespace:MauiGallery.Features.PlatformApis"
            x:DataType="SamplePageViewModel">
    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PageContent}">
            <ControlPageHeader />

            <!-- 1. Current network -->
            <ControlExample x:Name="StatusExample"
                            Title="The current network"
                            Description="NetworkAccess says how much of the network the device can reach: Internet, ConstrainedInternet (behind a captive portal), Local, None or Unknown. ConnectionProfiles lists the connections in use, such as WiFi, Cellular, Ethernet or Bluetooth. NetworkAccess.Internet means a route exists, not that a particular server answers."
                            ShowStyleToggle="False"
                            XamlSource="ConnectivityStatus.xaml.txt"
                            CSharpSource="ConnectivityStatus.cs.txt">
                <Grid x:Name="StatusSample"
                      x:DataType="local:ConnectivityViewModel"
                      ColumnDefinitions="Auto,*"
                      RowDefinitions="Auto,Auto"
                      ColumnSpacing="16"
                      RowSpacing="8"
                      WidthRequest="{OnIdiom Phone=280, Default=380}">
                    <Label Text="Network access" Opacity="0.7" />
                    <Label Grid.Column="1" Text="{Binding Access}" AutomationId="sample-connectivity-access" />
                    <Label Grid.Row="1" Text="Profiles" Opacity="0.7" />
                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding Profiles}" AutomationId="sample-connectivity-profiles" />
                </Grid>
            </ControlExample>

            <!-- 2. Check before going online -->
            <ControlExample x:Name="LoadExample"
                            Title="Check before you go online"
                            Description="Check NetworkAccess before a request, so people without a connection get an instant answer, such as cached content, instead of waiting for a timeout. Turn on airplane mode and tap Load to see the offline path."
                            ShowStyleToggle="False"
                            XamlSource="ConnectivityCheck.xaml.txt"
                            CSharpSource="ConnectivityCheck.cs.txt">
                <VerticalStackLayout x:Name="LoadSample"
                                     x:DataType="local:ConnectivityViewModel"
                                     Spacing="12"
                                     WidthRequest="{OnIdiom Phone=280, Default=380}">
                    <Button x:Name="LoadButton"
                            Text="Load headlines"
                            Command="{Binding LoadHeadlinesCommand}"
                            HorizontalOptions="Start"
                            AutomationId="sample-connectivity-load" />
                    <Label Text="{Binding Headlines}" AutomationId="sample-connectivity-headlines" />
                </VerticalStackLayout>
            </ControlExample>

            <!-- 3. React to changes -->
            <ControlExample x:Name="ChangesExample"
                            Title="React when the network changes"
                            Description="ConnectivityChanged fires when the device connects, disconnects or switches networks, for example to retry failed uploads when the connection comes back. Subscribe while the page is visible and unsubscribe when it goes away. Toggle Wi-Fi or airplane mode to log a few changes."
                            ShowStyleToggle="False"
                            XamlSource="ConnectivityChanged.xaml.txt"
                            CSharpSource="ConnectivityChanged.cs.txt">
                <VerticalStackLayout x:Name="ChangesSample"
                                     x:DataType="local:ConnectivityViewModel"
                                     Spacing="6"
                                     WidthRequest="{OnIdiom Phone=280, Default=380}">
                    <Label Text="{Binding IsOnline, StringFormat='IsOnline = {0}'}" FontAttributes="Bold" AutomationId="sample-connectivity-online" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Changes}" Spacing="4" AutomationId="sample-connectivity-log">
                        <BindableLayout.EmptyView>
                            <Label Text="No changes yet. Turn Wi-Fi or airplane mode on or off." Opacity="0.7" />
                        </BindableLayout.EmptyView>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Label Text="{Binding .}" FontSize="13" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ControlExample>

            <RelatedItems />
        </VerticalStackLayout>
    </ScrollView>
</SamplePage>

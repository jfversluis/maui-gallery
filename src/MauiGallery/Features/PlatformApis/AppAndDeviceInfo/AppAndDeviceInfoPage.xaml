<SamplePage x:Class="MauiGallery.Features.PlatformApis.AppAndDeviceInfoPage"
            x:DataType="SamplePageViewModel">
    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PageContent}">
            <ControlPageHeader />

            <!-- 1. AppInfo -->
            <ControlExample x:Name="AppExample"
                            Title="App information"
                            ShowNativeBadge="False"
                            ShowStyleToggle="False"
                            ShowRtlToggle="False"
                            Description="AppInfo reads your app's name, package id, version and build from the platform's metadata, so an About screen never goes out of date. RequestedTheme is the operating system's light or dark setting, even when the app overrides it with UserAppTheme, and ShowSettingsUI opens your app's page in the system settings, which is where people grant permissions they denied earlier."
                            XamlSource="AppInfoBasic.xaml.txt"
                            CSharpSource="AppInfoBasic.cs.txt">
                <VerticalStackLayout x:Name="AppSample"
                                     x:DataType="AppInfoViewModel"
                                     Spacing="16"
                                     WidthRequest="{OnIdiom Phone=280, Default=380}">
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="8">
                        <Label Text="Name" Opacity="0.7" />
                        <Label Grid.Column="1" Text="{Name}" AutomationId="sample-appinfo-name" />
                        <Label Grid.Row="1" Text="Package" Opacity="0.7" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{PackageName}" AutomationId="sample-appinfo-package" />
                        <Label Grid.Row="2" Text="Version" Opacity="0.7" />
                        <Label Grid.Row="2" Grid.Column="1" Text="{.Version}" AutomationId="sample-appinfo-version" />
                        <Label Grid.Row="3" Text="Build" Opacity="0.7" />
                        <Label Grid.Row="3" Grid.Column="1" Text="{Build}" AutomationId="sample-appinfo-build" />
                        <Label Grid.Row="4" Text="OS theme" Opacity="0.7" />
                        <Label Grid.Row="4" Grid.Column="1" Text="{Theme}" AutomationId="sample-appinfo-theme" />
                        <Label Grid.Row="5" Text="In-app theme" Opacity="0.7" />
                        <Label x:Name="InAppTheme" Grid.Row="5" Grid.Column="1" AutomationId="sample-appinfo-app-theme" />
                        <Label Grid.Row="6" Text="Layout" Opacity="0.7" />
                        <Label Grid.Row="6" Grid.Column="1" Text="{.LayoutDirection}" />
                    </Grid>
                    <Button x:Name="AppSettingsButton"
                            Text="Open app settings"
                            Command="{Binding ShowSettingsCommand}"
                            Clicked="OnShowSettingsClicked"
                            HorizontalOptions="Start"
                            AutomationId="sample-appinfo-settings" />
                </VerticalStackLayout>
            </ControlExample>

            <!-- 2. DeviceInfo -->
            <ControlExample x:Name="DeviceExample"
                            Title="Device information"
                            ShowNativeBadge="False"
                            ShowStyleToggle="False"
                            ShowRtlToggle="False"
                            Description="DeviceInfo describes the hardware and operating system: the model and manufacturer, the platform and its version, and the idiom (phone, tablet, desktop). DeviceType tells a physical device from a simulator or emulator, handy for turning off features a simulator can't do."
                            XamlSource="DeviceInfoBasic.xaml.txt"
                            CSharpSource="DeviceInfoBasic.cs.txt">
                <Grid x:Name="DeviceSample"
                      x:DataType="DeviceInfoViewModel"
                      ColumnDefinitions="Auto,*"
                      RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                      ColumnSpacing="16"
                      RowSpacing="8"
                      WidthRequest="{OnIdiom Phone=280, Default=380}">
                    <Label Text="Model" Opacity="0.7" />
                    <Label Grid.Column="1" Text="{Model}" AutomationId="sample-deviceinfo-model" />
                    <Label Grid.Row="1" Text="Manufacturer" Opacity="0.7" />
                    <Label Grid.Row="1" Grid.Column="1" Text="{Manufacturer}" />
                    <Label Grid.Row="2" Text="Name" Opacity="0.7" />
                    <Label Grid.Row="2" Grid.Column="1" Text="{Name}" />
                    <Label Grid.Row="3" Text="Platform" Opacity="0.7" />
                    <Label Grid.Row="3" Grid.Column="1" Text="{.Platform}" AutomationId="sample-deviceinfo-platform" />
                    <Label Grid.Row="4" Text="Version" Opacity="0.7" />
                    <Label Grid.Row="4" Grid.Column="1" Text="{.Version}" />
                    <Label Grid.Row="5" Text="Idiom" Opacity="0.7" />
                    <Label Grid.Row="5" Grid.Column="1" Text="{Idiom}" AutomationId="sample-deviceinfo-idiom" />
                    <Label Grid.Row="6" Text="Device type" Opacity="0.7" />
                    <Label Grid.Row="6" Grid.Column="1" Text="{.DeviceType}" AutomationId="sample-deviceinfo-type" />
                </Grid>
            </ControlExample>

            <!-- 3. DeviceDisplay -->
            <ControlExample x:Name="DisplayExample"
                            Title="Display information"
                            ShowNativeBadge="False"
                            ShowStyleToggle="False"
                            ShowRtlToggle="False"
                            Description="DeviceDisplay.MainDisplayInfo reports the screen's size in pixels, its density, orientation, rotation and refresh rate; divide by the density for the units your layouts use. MainDisplayInfoChanged fires when the device rotates, and KeepScreenOn stops the screen from sleeping, for a recipe or a boarding pass. Turn it off again when the page goes away."
                            XamlSource="DeviceDisplayBasic.xaml.txt"
                            CSharpSource="DeviceDisplayBasic.cs.txt">
                <Grid x:Name="DisplaySample"
                      x:DataType="DisplayInfoViewModel"
                      ColumnDefinitions="Auto,*"
                      RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                      ColumnSpacing="16"
                      RowSpacing="8"
                      WidthRequest="{OnIdiom Phone=280, Default=380}">
                    <Label Text="Size" Opacity="0.7" />
                    <Label Grid.Column="1" Text="{SizeInPixels}" AutomationId="sample-display-size" />
                    <Label Grid.Row="1" Text="In units" Opacity="0.7" />
                    <Label Grid.Row="1" Grid.Column="1" Text="{SizeInUnits}" />
                    <Label Grid.Row="2" Text="Density" Opacity="0.7" />
                    <Label Grid.Row="2" Grid.Column="1" Text="{$'{Info.Density:0.##}x'}" AutomationId="sample-display-density" />
                    <Label Grid.Row="3" Text="Orientation" Opacity="0.7" />
                    <Label Grid.Row="3" Grid.Column="1" Text="{Info.Orientation}" AutomationId="sample-display-orientation" />
                    <Label Grid.Row="4" Text="Rotation" Opacity="0.7" />
                    <Label Grid.Row="4" Grid.Column="1" Text="{Info.Rotation}" />
                    <Label Grid.Row="5" Text="Refresh rate" Opacity="0.7" />
                    <Label Grid.Row="5" Grid.Column="1" Text="{$'{Info.RefreshRate:0} Hz'}" />
                    <Label Grid.Row="6" Text="Screen on" Opacity="0.7" />
                    <Label Grid.Row="6" Grid.Column="1" Text="{$'KeepScreenOn = {KeepScreenOn}'}" AutomationId="sample-display-keep-on" />
                </Grid>
                <ControlExample.Options>
                    <Grid x:Name="DisplayOptions" x:DataType="DisplayInfoViewModel" ColumnDefinitions="*,Auto">
                        <Label Text="KeepScreenOn" Style="{StaticResource OptionLabel}" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{KeepScreenOn}" AutomationId="option-display-keep-on" />
                    </Grid>
                </ControlExample.Options>
            </ControlExample>

            <RelatedItems />
        </VerticalStackLayout>
    </ScrollView>
</SamplePage>

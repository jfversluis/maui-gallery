<SamplePage x:Class="MauiGallery.Features.Controls.Pickers.PickerPage"
            x:DataType="SamplePageViewModel">
    <SamplePage.Resources>
        <x:Array x:Key="Sizes" Type="{x:Type x:String}">
            <x:String>Small</x:String>
            <x:String>Medium</x:String>
            <x:String>Large</x:String>
            <x:String>Extra large</x:String>
        </x:Array>
    </SamplePage.Resources>

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PageContent}">
            <ControlPageHeader />

            <!-- 1. The basics -->
            <ControlExample x:Name="BasicExample"
                            Title="Pick from a list"
                            Description="A Picker lets people choose one item from a list. Title prompts for a choice until something is selected; a label above it keeps the question visible after that."
                            XamlSource="PickerBasic.xaml.txt"
                            CSharpSource="PickerBasic.cs.txt">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Size" FontAttributes="Bold" AutomationId="sample-basic-label" />
                    <Picker x:Name="BasicPicker"
                            WidthRequest="280"
                            Title="{Binding Text, Source={x:Reference BasicTitle}, x:DataType=Entry}"
                            SelectedIndexChanged="OnBasicSelectedIndexChanged"
                            ItemsSource="{StaticResource Sizes}"
                            AutomationId="sample-basic-picker" />
                </VerticalStackLayout>
                <ControlExample.Options>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Title" Style="{StaticResource OptionLabel}" />
                        <Entry x:Name="BasicTitle" Text="Choose a size" AutomationId="option-basic-title" />
                        <Button Text="Clear selection"
                                Clicked="OnBasicClearClicked"
                                HorizontalOptions="Start"
                                AutomationId="option-basic-clear" />
                    </VerticalStackLayout>
                </ControlExample.Options>
                <ControlExample.Substitutions>
                    <Substitution Key="Title" Value="{Binding Text, Source={x:Reference BasicTitle}, x:DataType=Entry}" Default="" />
                </ControlExample.Substitutions>
            </ControlExample>

            <!-- 2. Objects and two-way binding -->
            <ControlExample x:Name="BindingExample"
                            Title="Bind to a list of objects"
                            Description="Bind ItemsSource to your own objects and use ItemDisplayBinding to choose the text to show. SelectedItem binds two-way, so the view model can change the selection too."
                            XamlSource="PickerBinding.xaml.txt"
                            CSharpSource="PickerBinding.cs.txt">
                <VerticalStackLayout x:Name="BindingSample"
                                     WidthRequest="280"
                                     Spacing="12"
                                     x:DataType="PickerBindingViewModel">
                    <Picker x:Name="BindingPicker"
                            Title="Choose a city"
                            ItemsSource="{Cities}"
                            ItemDisplayBinding="{Binding Name, x:DataType=City}"
                            SelectedItem="{Binding SelectedCity}"
                            AutomationId="sample-binding-picker" />
                    <Label Text="{Summary}" AutomationId="sample-binding-summary" />
                    <Button Text="Surprise me"
                            Command="{Binding PickRandomCommand}"
                            HorizontalOptions="Start"
                            AutomationId="sample-binding-random" />
                </VerticalStackLayout>
            </ControlExample>

            <PlatformShowcase />
            <RelatedItems />
        </VerticalStackLayout>
    </ScrollView>
</SamplePage>

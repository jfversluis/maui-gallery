<SamplePage x:Class="MauiGallery.Features.Controls.Pickers.TimePickerPage"
            xmlns:local="clr-namespace:MauiGallery.Features.Controls.Pickers"
            x:DataType="SamplePageViewModel">
    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PageContent}">
            <ControlPageHeader />

            <!-- 1. The basics -->
            <ControlExample x:Name="BasicExample"
                            Title="Pick a time"
                            Description="A TimePicker shows a time of day and opens the platform's clock or wheel to change it. Format &quot;t&quot; follows the device's 12 or 24-hour setting; &quot;HH:mm&quot; and &quot;h:mm tt&quot; force one."
                            XamlSource="TimePickerBasic.xaml.txt"
                            CSharpSource="TimePickerBasic.cs.txt">
                <TimePicker x:Name="BasicTimePicker"
                            Time="9:30"
                            Format="{Binding SelectedItem, Source={x:Reference BasicFormat}, x:DataType=Picker}"
                            TimeSelected="OnBasicTimeSelected"
                            AutomationId="sample-basic-time-picker" />
                <ControlExample.Options>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Format" Style="{StaticResource OptionLabel}" />
                        <Picker x:Name="BasicFormat"
                                SelectedIndex="0"
                                SelectedIndexChanged="OnBasicFormatChanged"
                                AutomationId="option-basic-format">
                            <Picker.ItemsSource>
                                <x:Array Type="{x:Type x:String}">
                                    <x:String>t</x:String>
                                    <x:String>T</x:String>
                                    <x:String>HH:mm</x:String>
                                    <x:String>h:mm tt</x:String>
                                </x:Array>
                            </Picker.ItemsSource>
                        </Picker>
                    </VerticalStackLayout>
                </ControlExample.Options>
                <ControlExample.Substitutions>
                    <Substitution Key="Format" Value="{Binding SelectedItem, Source={x:Reference BasicFormat}, x:DataType=Picker}" Default="t" />
                </ControlExample.Substitutions>
            </ControlExample>

            <!-- 2. No time yet, open from code -->
            <ControlExample x:Name="OptionalExample"
                            Title="Start empty and open from code"
                            Description="Time is nullable, so a TimePicker can show no time until one is chosen. Set IsOpen to show the picker from your own button."
                            XamlSource="TimePickerOptional.xaml.txt"
                            CSharpSource="TimePickerOptional.cs.txt">
                <VerticalStackLayout x:Name="OptionalSample"
                                     WidthRequest="280"
                                     Spacing="12"
                                     x:DataType="local:TimePickerOptionalViewModel">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Label Text="Reminder" VerticalOptions="Center" />
                        <TimePicker x:Name="OptionalPicker"
                                    Grid.Column="1"
                                    Time="{Binding ReminderTime}"
                                    IsOpen="{Binding IsPickerOpen}"
                                    AutomationId="sample-optional-time-picker" />
                    </Grid>
                    <Label Text="{Binding Summary}" AutomationId="sample-optional-summary" />
                    <HorizontalStackLayout Spacing="8">
                        <Button Text="Choose a time"
                                Command="{Binding ChooseCommand}"
                                AutomationId="sample-optional-choose" />
                        <Button Text="Clear"
                                Command="{Binding ClearCommand}"
                                AutomationId="sample-optional-clear" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </ControlExample>

            <RelatedItems />
        </VerticalStackLayout>
    </ScrollView>
</SamplePage>

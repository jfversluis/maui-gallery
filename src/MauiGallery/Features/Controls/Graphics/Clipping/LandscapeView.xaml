<!-- A picture drawn with shapes, used as the content to clip; the gallery ships no photos. It scales to any size. -->
<ContentView x:Class="MauiGallery.Features.Controls.Graphics.LandscapeView"
             x:DataType="LandscapeView">
    <Grid RowDefinitions="4*,3*,2*">
        <Grid.Background>
            <LinearGradientBrush EndPoint="0,1">
                <GradientStop Color="#312E81" Offset="0" />
                <GradientStop Color="#DB2777" Offset="0.6" />
                <GradientStop Color="#FDBA74" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>
        <Ellipse Grid.RowSpan="2"
                 WidthRequest="64"
                 HeightRequest="64"
                 HorizontalOptions="Center"
                 VerticalOptions="Center"
                 Fill="#FDE68A" />
        <Polygon Grid.Row="1"
                 Grid.RowSpan="2"
                 Points="0,100 0,60 22,20 45,55 70,0 100,50 100,100"
                 Aspect="Fill"
                 Fill="#4C1D95" />
        <Polygon Grid.Row="2"
                 Points="0,100 0,40 30,0 60,50 85,10 100,30 100,100"
                 Aspect="Fill"
                 Fill="#1E1B4B"
                 Margin="0,0,0,-1" />
    </Grid>
</ContentView>

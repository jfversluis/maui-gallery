<SamplePage x:Class="MauiGallery.Features.Controls.Collections.RefreshViewPage"
            xmlns:icons="clr-namespace:IconFont.Maui.FluentIcons;assembly=IconFont.Maui.FluentIcons"
            xmlns:local="clr-namespace:MauiGallery.Features.Controls.Collections"
            x:DataType="SamplePageViewModel">
    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PageContent}">
            <ControlPageHeader />

            <!-- 1. Command and IsRefreshing -->
            <ControlExample x:Name="ListExample"
                            Title="Pull to refresh a list"
                            Description="Wrap a scrollable view in a RefreshView and bind Command and IsRefreshing. Pulling down sets IsRefreshing and runs the command; set it back to false when the data is in. Desktop pointers can't pull, so offer a refresh button that sets IsRefreshing too."
                            XamlSource="RefreshViewList.xaml.txt"
                            CSharpSource="RefreshViewList.cs.txt">
                <VerticalStackLayout x:Name="ListSample"
                                     Spacing="8"
                                     WidthRequest="{OnIdiom Phone=280, Default=400}"
                                     x:DataType="local:WeatherFeedViewModel">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Text="{Binding LastUpdated}"
                               FontSize="13"
                               TextColor="{AppThemeBinding Light=#6E6E73, Dark=#AEAEB2}"
                               VerticalOptions="Center"
                               AutomationId="sample-list-updated" />
                        <Button Grid.Column="1"
                                Text="Refresh"
                                Command="{Binding StartRefreshCommand}"
                                AutomationId="sample-list-refresh">
                            <Button.ImageSource>
                                <FontImageSource FontFamily="{x:Static icons:FluentIconsRegular.FontFamily}"
                                                 Glyph="{x:Static icons:FluentIconsRegular.ArrowSync24}"
                                                 Color="{AppThemeBinding Light=#1C1C1E, Dark=#FFFFFF}"
                                                 Size="16" />
                            </Button.ImageSource>
                        </Button>
                    </Grid>
                    <RefreshView x:Name="ListRefresh"
                                 HeightRequest="280"
                                 IsRefreshing="{Binding IsRefreshing}"
                                 Command="{Binding RefreshCommand}"
                                 RefreshColor="{Binding SelectedColor, Source={x:Reference ListColor}, x:DataType=SwatchPicker}"
                                 IsRefreshEnabled="{Binding IsToggled, Source={x:Reference ListEnabled}, x:DataType=Switch}"
                                 AutomationId="sample-list-refresh-view">
                        <CollectionView ItemsSource="{Binding Cities}" AutomationId="sample-list-collection">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="local:CityWeather">
                                    <Grid Padding="12,8" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Label Text="{Binding Glyph}"
                                               FontFamily="{x:Static icons:FluentIconsRegular.FontFamily}"
                                               FontSize="28"
                                               TextColor="#D97706"
                                               VerticalOptions="Center" />
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                            <Label Text="{Binding City}" FontAttributes="Bold" />
                                            <Label Text="{Binding Condition}"
                                                   FontSize="13"
                                                   TextColor="{AppThemeBinding Light=#6E6E73, Dark=#AEAEB2}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2"
                                               Text="{Binding TemperatureText}"
                                               FontSize="22"
                                               VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </RefreshView>
                </VerticalStackLayout>
                <ControlExample.Options>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="RefreshColor" Style="{StaticResource OptionLabel}" />
                        <SwatchPicker x:Name="ListColor" />
                        <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                            <Label Text="IsRefreshEnabled" Style="{StaticResource OptionLabel}" VerticalOptions="Center" />
                            <Switch x:Name="ListEnabled" Grid.Column="1" IsToggled="True" AutomationId="option-refresh-enabled" />
                        </Grid>
                    </VerticalStackLayout>
                </ControlExample.Options>
                <ControlExample.Substitutions>
                    <Substitution Key="RefreshColor" Value="{Binding SelectedColor, Source={x:Reference ListColor}, x:DataType=SwatchPicker}" />
                    <Substitution Key="IsRefreshEnabled" Value="{Binding IsToggled, Source={x:Reference ListEnabled}, x:DataType=Switch}" Default="True" />
                </ControlExample.Substitutions>
            </ControlExample>

            <!-- 2. Refreshing event -->
            <ControlExample x:Name="EventExample"
                            Title="Refresh any scrollable content"
                            Description="The content doesn't have to be a list: any ScrollView works. Without MVVM, handle the Refreshing event and set IsRefreshing to false when you're done. Setting IsRefreshing to true from code starts a refresh too."
                            XamlSource="RefreshViewEvent.xaml.txt"
                            CSharpSource="RefreshViewEvent.cs.txt">
                <RefreshView x:Name="BudgetRefresh"
                             WidthRequest="{OnIdiom Phone=280, Default=400}"
                             HeightRequest="200"
                             Refreshing="OnBudgetRefreshing"
                             AutomationId="sample-event-refresh-view">
                    <ScrollView>
                        <VerticalStackLayout Padding="16" Spacing="8">
                            <Label Text="Trip budget" FontAttributes="Bold" />
                            <Label x:Name="BudgetSpent"
                                   Text="$1,240 of $2,000"
                                   FontSize="28"
                                   FontAttributes="Bold"
                                   AutomationId="sample-event-spent" />
                            <ProgressBar x:Name="BudgetProgress" Progress="0.62" />
                            <Label x:Name="BudgetUpdated"
                                   Text="Pull down to sync with your bank"
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light=#6E6E73, Dark=#AEAEB2}"
                                   AutomationId="sample-event-updated" />
                        </VerticalStackLayout>
                    </ScrollView>
                </RefreshView>
                <ControlExample.Options>
                    <Button Text="Set IsRefreshing = true"
                            Clicked="OnBudgetRefreshClicked"
                            HorizontalOptions="Start"
                            AutomationId="option-start-refresh" />
                </ControlExample.Options>
            </ControlExample>

            <RelatedItems />
        </VerticalStackLayout>
    </ScrollView>
</SamplePage>

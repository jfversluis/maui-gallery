<SamplePage x:Class="MauiGallery.Features.Controls.Collections.CarouselViewPage"
            xmlns:icons="clr-namespace:IconFont.Maui.FluentIcons;assembly=IconFont.Maui.FluentIcons"
            xmlns:local="clr-namespace:MauiGallery.Features.Controls.Collections"
            x:DataType="SamplePageViewModel">
    <SamplePage.Resources>
        <!-- One card per trip, shared by the examples on this page. -->
        <DataTemplate x:Key="TripTemplate" x:DataType="local:Trip">
            <Border StrokeShape="RoundRectangle 16"
                    StrokeThickness="0"
                    BackgroundColor="{Binding Color}"
                    Padding="20">
                <Grid RowDefinitions="*,Auto,Auto">
                    <Label Text="{Binding Glyph}"
                           FontFamily="{x:Static icons:FluentIconsRegular.FontFamily}"
                           FontSize="40"
                           TextColor="White" />
                    <Label Grid.Row="1"
                           Text="{Binding Title}"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="White" />
                    <Label Grid.Row="2"
                           Text="{Binding Details}"
                           TextColor="#E6FFFFFF"
                           LineBreakMode="TailTruncation" />
                </Grid>
            </Border>
        </DataTemplate>
    </SamplePage.Resources>

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PageContent}">
            <ControlPageHeader />

            <!-- 1. The basics -->
            <ControlExample x:Name="BasicExample"
                            Title="Swipe through items"
                            Description="CarouselView shows one item at a time and snaps to it as people swipe. Loop wraps around at the ends, and PeekAreaInsets reveals the edges of the neighboring items to hint that there is more."
                            XamlSource="CarouselViewBasic.xaml.txt"
                            CSharpSource="CarouselViewBasic.cs.txt">
                <CarouselView x:Name="BasicCarousel"
                              WidthRequest="{OnIdiom Phone=280, Default=400}"
                              HeightRequest="200"
                              ItemsSource="{x:Static local:TripData.All}"
                              ItemTemplate="{StaticResource TripTemplate}"
                              PeekAreaInsets="40,0"
                              CurrentItemChanged="OnBasicCurrentItemChanged"
                              AutomationId="sample-basic-carousel">
                    <CarouselView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal"
                                           ItemSpacing="8"
                                           SnapPointsType="MandatorySingle"
                                           SnapPointsAlignment="Center" />
                    </CarouselView.ItemsLayout>
                </CarouselView>
                <ControlExample.Options>
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Loop" Style="{StaticResource OptionLabel}" VerticalOptions="Center" />
                            <Switch x:Name="BasicLoop" Grid.Column="1" IsToggled="True" Toggled="OnBasicLoopToggled" AutomationId="option-loop" />
                        </Grid>
                        <Label Text="{Binding Value, Source={x:Reference BasicPeek}, StringFormat='PeekAreaInsets: {0:0}', x:DataType=Slider}"
                               Style="{StaticResource OptionLabel}" />
                        <Slider x:Name="BasicPeek"
                                Minimum="0"
                                Maximum="60"
                                Value="40"
                                ValueChanged="OnBasicPeekChanged"
                                AutomationId="option-peek" />
                    </VerticalStackLayout>
                </ControlExample.Options>
                <ControlExample.Substitutions>
                    <Substitution Key="Loop" Value="{Binding IsToggled, Source={x:Reference BasicLoop}, x:DataType=Switch}" Default="True" />
                    <Substitution Key="PeekAreaInsets" Value="{Binding Value, Source={x:Reference BasicPeek}, x:DataType=Slider, Converter={StaticResource Rounded}}" Default="0" />
                </ControlExample.Substitutions>
            </ControlExample>

            <!-- 2. Position and CurrentItem -->
            <ControlExample x:Name="PositionExample"
                            Title="Bind the position and current item"
                            Description="Position and CurrentItem are two-way: read them to follow the user, or set them from your view model to move the carousel, for example from previous and next buttons."
                            XamlSource="CarouselViewPosition.xaml.txt"
                            CSharpSource="CarouselViewPosition.cs.txt">
                <VerticalStackLayout x:Name="PositionSample"
                                     Spacing="12"
                                     WidthRequest="{OnIdiom Phone=280, Default=400}"
                                     x:DataType="local:TripCarouselViewModel">
                    <CarouselView x:Name="PositionCarousel"
                                  HeightRequest="200"
                                  ItemsSource="{Binding Trips}"
                                  ItemTemplate="{StaticResource TripTemplate}"
                                  Position="{Binding Position}"
                                  CurrentItem="{Binding CurrentItem}"
                                  Loop="False"
                                  AutomationId="sample-position-carousel" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Button Text="Previous"
                                Command="{Binding PreviousCommand}"
                                AutomationId="sample-position-previous" />
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="{Binding CurrentItem.Title}"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"
                                   AutomationId="sample-position-title" />
                            <Label Text="{Binding PositionText}"
                                   FontSize="13"
                                   HorizontalTextAlignment="Center"
                                   AutomationId="sample-position-text" />
                        </VerticalStackLayout>
                        <Button Grid.Column="2"
                                Text="Next"
                                Command="{Binding NextCommand}"
                                AutomationId="sample-position-next" />
                    </Grid>
                </VerticalStackLayout>
            </ControlExample>

            <!-- 3. IndicatorView -->
            <ControlExample x:Name="IndicatorExample"
                            Title="Show where people are with an IndicatorView"
                            Description="Point the carousel's IndicatorView property at an IndicatorView, and it shows one dot per item and follows the position. Tapping a dot moves the carousel."
                            XamlSource="CarouselViewIndicator.xaml.txt"
                            CSharpSource="CarouselViewIndicator.cs.txt">
                <VerticalStackLayout Spacing="12" WidthRequest="{OnIdiom Phone=280, Default=400}">
                    <CarouselView x:Name="IndicatorCarousel"
                                  HeightRequest="200"
                                  ItemsSource="{x:Static local:TripData.All}"
                                  ItemTemplate="{StaticResource TripTemplate}"
                                  IndicatorView="{x:Reference TripIndicator}"
                                  AutomationId="sample-indicator-carousel" />
                    <IndicatorView x:Name="TripIndicator"
                                   IndicatorColor="{AppThemeBinding Light=#D1D1D6, Dark=#48484A}"
                                   SelectedIndicatorColor="{AppThemeBinding Light=#1C1C1E, Dark=#FFFFFF}"
                                   HorizontalOptions="Center"
                                   AutomationId="sample-indicator-view" />
                </VerticalStackLayout>
            </ControlExample>

            <RelatedItems />
        </VerticalStackLayout>
    </ScrollView>
</SamplePage>

<ContentPage x:Class="MauiGallery.Features.Settings.SettingsPage"
             x:DataType="SettingsViewModel"
             Title="Settings"
             Style="{StaticResource PageChrome}">
    <ContentPage.Resources>
        <Style x:Key="SettingRow" TargetType="Grid">
            <Setter Property="ColumnDefinitions" Value="*,Auto" />
            <Setter Property="ColumnSpacing" Value="16" />
            <Setter Property="Padding" Value="20,14" />
        </Style>
    </ContentPage.Resources>
    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PageContent}" MaximumWidthRequest="760">
            <Label Text="Settings" Style="{StaticResource TextTitle1}" />

            <VerticalStackLayout Spacing="12">
                <SectionHeader Title="Appearance" />
                <Border Style="{StaticResource Card}" Padding="20,16">
                    <VerticalStackLayout Spacing="4" RadioButtonGroup.GroupName="theme" RadioButtonGroup.SelectedValue="{Theme}">
                        <Label Text="Theme" Style="{StaticResource TextBodyStrong}" SemanticProperties.HeadingLevel="Level3" />
                        <Label Text="Applies to the app and to every native control in the samples."
                               Style="{StaticResource TextCaption}"
                               Margin="0,0,0,8" />
                        <RadioButton Content="Use system setting" Value="{x:Static ThemePreference.System}" AutomationId="theme-system" MinimumHeightRequest="{OnPlatform Android=48}" />
                        <RadioButton Content="Light" Value="{x:Static ThemePreference.Light}" AutomationId="theme-light" MinimumHeightRequest="{OnPlatform Android=48}" />
                        <RadioButton Content="Dark" Value="{x:Static ThemePreference.Dark}" AutomationId="theme-dark" MinimumHeightRequest="{OnPlatform Android=48}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="12">
                <SectionHeader Title="About" />
                <Border Style="{StaticResource Card}" Padding="0">
                    <VerticalStackLayout>
                        <Grid Style="{StaticResource SettingRow}">
                            <Label Text="App version" Style="{StaticResource TextBody}" />
                            <Label Grid.Column="1" Text="{AppVersion}" Style="{StaticResource TextBodySecondary}" />
                        </Grid>
                        <BoxView Style="{StaticResource Divider}" />
                        <Grid Style="{StaticResource SettingRow}">
                            <Label Text=".NET MAUI" Style="{StaticResource TextBody}" />
                            <Label Grid.Column="1" Text="{MauiVersion}" Style="{StaticResource TextBodySecondary}" AutomationId="about-maui-version" />
                        </Grid>
                        <BoxView Style="{StaticResource Divider}" />
                        <Grid Style="{StaticResource SettingRow}">
                            <Label Text=".NET runtime" Style="{StaticResource TextBody}" />
                            <Label Grid.Column="1" Text="{DotNetVersion}" Style="{StaticResource TextBodySecondary}" />
                        </Grid>
                        <BoxView Style="{StaticResource Divider}" />
                        <Grid Style="{StaticResource SettingRow}">
                            <Label Text="Device" Style="{StaticResource TextBody}" />
                            <Label Grid.Column="1" Text="{PlatformDescription}" Style="{StaticResource TextBodySecondary}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
                <FlexLayout Wrap="Wrap">
                    <Button Text="Source on GitHub" Style="{StaticResource SecondaryButton}" Command="{Binding OpenRepositoryCommand}" Margin="0,0,8,8" />
                    <Button Text="Report an issue" Style="{StaticResource SecondaryButton}" Command="{Binding ReportIssueCommand}" Margin="0,0,8,8" />
                    <Button Text="Privacy policy" Style="{StaticResource SecondaryButton}" Command="{Binding OpenPrivacyPolicyCommand}" Margin="0,0,8,8" />
                </FlexLayout>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="12">
                <SectionHeader Title="Third-party notices" />
                <Border Style="{StaticResource Card}" Padding="0">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Notices}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="LicenseNotice">
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OpenNoticeCommand, Source={RelativeSource AncestorType={x:Type SettingsViewModel}}, x:DataType=SettingsViewModel}"
                                                              CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>
                                    <Label Text="{Name}" Style="{StaticResource TextBody}" />
                                    <Label Grid.Column="1" Text="{License}" Style="{StaticResource TextCaption}" VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

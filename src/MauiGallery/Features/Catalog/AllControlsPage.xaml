<ContentPage x:Class="MauiGallery.Features.Catalog.AllControlsPage"
             x:DataType="AllControlsViewModel"
             Title="All controls"
             Style="{StaticResource PageChrome}">
    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PageContent}" Spacing="32">
            <VerticalStackLayout Spacing="8">
                <Label Text="All controls" Style="{StaticResource TextTitle1}" />
                <Label Text="{$'{ItemCount} pages of controls, APIs and guidance. Every sample runs live on this device.'}"
                       Style="{StaticResource TextBodySecondary}" />
            </VerticalStackLayout>
            <VerticalStackLayout BindableLayout.ItemsSource="{Sections}" Spacing="32">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="CategorySection">
                        <VerticalStackLayout Spacing="12">
                            <SectionHeader Title="{Category.Title}" />
                            <AdaptiveGrid MinItemWidth="260" BindableLayout.ItemsSource="{Items}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="GalleryItem">
                                        <ItemCard Command="{Binding OpenItemCommand, Source={RelativeSource AncestorType={x:Type AllControlsViewModel}}, x:DataType=AllControlsViewModel}" />
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </AdaptiveGrid>
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

<ContentPage x:Class="MauiGallery.Features.Catalog.CategoryPage"
             x:DataType="CategoryViewModel"
             Title="{Binding Category.Title}"
             Shell.NavBarIsVisible="True"
             Style="{StaticResource PageChrome}">
    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PageContent}">
            <VerticalStackLayout Spacing="8">
                <Label Text="{Binding Category.Title}" Style="{StaticResource TextTitle1}" />
                <Label Text="{Binding Category.Description}" Style="{StaticResource TextBodySecondary}" />
            </VerticalStackLayout>
            <AdaptiveGrid MinItemWidth="260" BindableLayout.ItemsSource="{Items}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="GalleryItem">
                        <ItemCard Command="{Binding OpenItemCommand, Source={RelativeSource AncestorType={x:Type CategoryViewModel}}, x:DataType=CategoryViewModel}" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </AdaptiveGrid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

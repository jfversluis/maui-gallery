<ContentView x:Class="MauiGallery.Features.Samples.RelatedItems"
             x:DataType="SamplePageViewModel"
             IsVisible="{HasRelated}">
    <VerticalStackLayout Spacing="12" Padding="0,16,0,0">
        <SectionHeader Title="Related" />
        <AdaptiveGrid MinItemWidth="280" BindableLayout.ItemsSource="{Related}">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="GalleryItem">
                    <ItemCard Command="{Binding OpenItemCommand, Source={RelativeSource AncestorType={x:Type SamplePageViewModel}}, x:DataType=SamplePageViewModel}" />
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </AdaptiveGrid>
    </VerticalStackLayout>
</ContentView>

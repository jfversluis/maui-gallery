<ContentView x:Class="MauiGallery.Features.Samples.ControlPageHeader"
             x:DataType="SamplePageViewModel">
    <ContentView.Resources>
        <FontImageSource x:Key="StarOutline" FontFamily="{x:Static FluentIconsRegular.FontFamily}" Glyph="{x:Static FluentIconsRegular.Star24}" Color="{DynamicResource ColorTextSecondary}" Size="20" />
        <FontImageSource x:Key="StarFilled" FontFamily="{x:Static FluentIconsFilled.FontFamily}" Glyph="{x:Static FluentIconsFilled.Star24}" Color="{DynamicResource ColorAccent}" Size="20" />
        <FontImageSource x:Key="LinkGlyph" FontFamily="{x:Static FluentIconsRegular.FontFamily}" Glyph="{x:Static FluentIconsRegular.Link24}" Color="{DynamicResource ColorTextSecondary}" Size="20" />
        <FontImageSource x:Key="LinkCopiedGlyph" FontFamily="{x:Static FluentIconsRegular.FontFamily}" Glyph="{x:Static FluentIconsRegular.Checkmark24}" Color="{DynamicResource ColorSuccess}" Size="20" />
        <Style x:Key="HeaderLinkButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinimumHeightRequest" Value="{OnIdiom Phone=44, Default=34}" />
        </Style>
    </ContentView.Resources>

    <VerticalStackLayout Spacing="12" Padding="0,8,0,8">
        <Label Text="{Category.Title}"
               Style="{StaticResource TextOverline}"
               TextColor="{DynamicResource ColorAccentText}" />

        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Label Text="{Item.Title}" Style="{StaticResource TextTitle1}" VerticalTextAlignment="Center" />
            <HorizontalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                <ImageButton Style="{StaticResource IconButton}"
                             Source="{StaticResource StarOutline}"
                             Command="{Binding ToggleFavoriteCommand}"
                             AutomationId="page-favorite"
                             SemanticProperties.Description="Favorite"
                             ToolTipProperties.Text="Favorite">
                    <ImageButton.Triggers>
                        <DataTrigger TargetType="ImageButton" Binding="{Binding IsFavorite}" Value="True">
                            <Setter Property="Source" Value="{StaticResource StarFilled}" />
                            <Setter Property="ToolTipProperties.Text" Value="Favorite (on)" />
                            <Setter Property="SemanticProperties.Description" Value="Favorite, on" />
                        </DataTrigger>
                    </ImageButton.Triggers>
                </ImageButton>
                <ImageButton Style="{StaticResource IconButton}"
                             Source="{StaticResource LinkGlyph}"
                             Command="{Binding CopyLinkCommand}"
                             AutomationId="page-copy-link"
                             SemanticProperties.Description="Copy link to this page"
                             ToolTipProperties.Text="Copy link to this page">
                    <ImageButton.Triggers>
                        <DataTrigger TargetType="ImageButton" Binding="{Binding LinkCopied}" Value="True">
                            <Setter Property="Source" Value="{StaticResource LinkCopiedGlyph}" />
                        </DataTrigger>
                    </ImageButton.Triggers>
                </ImageButton>
            </HorizontalStackLayout>
        </Grid>

        <Label Text="{Item.Description}"
               Style="{StaticResource TextBodySecondary}"
               FontSize="16" />

        <!-- Wide: every platform. Narrow: this platform's native type, with the others behind a disclosure. -->
        <VerticalStackLayout IsVisible="{HasNativeMappings}">
            <FlexLayout x:Name="AllMappings"
                        Wrap="Wrap"
                        BindableLayout.ItemsSource="{NativeMappings}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="NativeMappingDisplay">
                        <Chip Text="{Text}" Margin="0,0,8,8" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>
            <FlexLayout x:Name="CompactMappings" Wrap="Wrap" AlignItems="Center" IsVisible="False">
                <Chip x:Name="CurrentMapping" Margin="0,0,8,8" />
                <Button x:Name="AllPlatformsButton"
                        Style="{StaticResource LinkButton}"
                        FontSize="13"
                        Padding="4,2"
                        MinimumHeightRequest="{OnIdiom Phone=44, Default=28}"
                        Margin="0,0,0,8"
                        Clicked="OnAllPlatformsClicked"
                        AutomationId="page-all-platforms" />
            </FlexLayout>
        </VerticalStackLayout>

        <FlexLayout Wrap="Wrap" Margin="0,4,0,0">
            <Button Text="Docs"
                    Style="{StaticResource HeaderLinkButton}"
                    Command="{Binding OpenLinkCommand}"
                    CommandParameter="{Binding Item.DocsUrl}"
                    IsVisible="{Item.DocsUrl != null}"
                    Margin="0,0,8,8"
                    AutomationId="page-docs">
                <Button.ImageSource>
                    <FontImageSource FontFamily="{x:Static FluentIconsRegular.FontFamily}" Glyph="{x:Static FluentIconsRegular.BookOpen24}" Color="{DynamicResource ColorTextPrimary}" Size="16" />
                </Button.ImageSource>
            </Button>
            <Button Text="API reference"
                    Style="{StaticResource HeaderLinkButton}"
                    Command="{Binding OpenLinkCommand}"
                    CommandParameter="{Binding Item.ApiUrl}"
                    IsVisible="{Item.ApiUrl != null}"
                    Margin="0,0,8,8"
                    AutomationId="page-api">
                <Button.ImageSource>
                    <FontImageSource FontFamily="{x:Static FluentIconsRegular.FontFamily}" Glyph="{x:Static FluentIconsRegular.Code24}" Color="{DynamicResource ColorTextPrimary}" Size="16" />
                </Button.ImageSource>
            </Button>
            <Button Text="Sample source"
                    Style="{StaticResource HeaderLinkButton}"
                    Command="{Binding OpenLinkCommand}"
                    CommandParameter="{Binding Item.SourceUrl}"
                    IsVisible="{Item.SourceUrl != null}"
                    Margin="0,0,8,8"
                    AutomationId="page-source">
                <Button.ImageSource>
                    <FontImageSource FontFamily="{x:Static FluentIconsRegular.FontFamily}" Glyph="{x:Static FluentIconsRegular.Open24}" Color="{DynamicResource ColorTextPrimary}" Size="16" />
                </Button.ImageSource>
            </Button>
        </FlexLayout>
    </VerticalStackLayout>
</ContentView>

<Project Sdk="Microsoft.NET.Sdk.Razor">
  <!-- The Razor SDK compiles the .razor components of the BlazorWebView sample. -->

  <PropertyGroup>
    <TargetFrameworks>net11.0-android</TargetFrameworks>
    <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net11.0-ios;net11.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net11.0-windows10.0.19041.0</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <RootNamespace>MauiGallery</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>

    <ApplicationTitle>.NET MAUI Gallery</ApplicationTitle>
    <!-- Phone home screens truncate the full name (".NET MAUI…"); the store listing keeps it. -->
    <ApplicationTitle Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">MAUI Gallery</ApplicationTitle>
    <!--
      Since .NET 10 the Mac app bundle's folder is named after ApplicationTitle, and App Store Connect rejects a bundle
      whose name starts with a dot (ITMS-90331), so name the folder without it. The app still shows ".NET MAUI Gallery".
    -->
    <_AppBundleName Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">MAUI Gallery</_AppBundleName>
    <ApplicationId>com.jfversluis.mauigallery</ApplicationId>
    <!--
      The version people see comes from Version in Directory.Build.props. The build number must grow with every store
      upload: the release workflow passes -p:ApplicationVersion=<run number>, local builds use 1.
    -->
    <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    <ApplicationVersion Condition="'$(ApplicationVersion)' == ''">1</ApplicationVersion>

    <!-- XAML: source-generated (the .NET 11 default) and strict, so binding mistakes fail the build. -->
    <MauiStrictXamlCompilation>true</MauiStrictXamlCompilation>
    <!--
      The app's code is trim- and AOT-safe: the trim, AOT and single-file analyzers run in every build, and any warning
      fails it (warnings are errors). Not IsAotCompatible: that also marks the app assembly trimmable, and trimming it
      strips the Razor components that BlazorWebView only references by type.
    -->
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <!-- The app's .css files are web content (HybridWebView, BlazorWebView), not .NET MAUI style sheets. -->
    <EnableDefaultCssItems>false</EnableDefaultCssItems>

    <WindowsPackageType>None</WindowsPackageType>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">17.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>

  <!--
    Release pipeline (docs/releasing.md, "Build configuration", has the reasoning, links and measurements):
    - iOS and Mac Catalyst: CoreCLR with composite ReadyToRun, the .NET 11 default.
    - Android: CoreCLR with composite ReadyToRun (the .NET 11 default), plus R8 to shrink and optimize the Java code.
    - Windows: CoreCLR with ReadyToRun, the default.
    NativeAOT and full trimming stay off: BlazorWebView (Razor components, JS interop) doesn't work with either in
    .NET 11 (dotnet/aspnetcore#70364). The app's own code is trim- and AOT-safe, and the analyzers keep it that way, so
    turning NativeAOT on later is a one-line change.
  -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' and '$(Configuration)' == 'Release'">
    <AndroidLinkTool>r8</AndroidLinkTool>
  </PropertyGroup>
  <!--
    .NET MAUI turns the trim analyzer off unless the app uses full trimming or NativeAOT. Keep it on, so a reflection-based
    binding or other trim-unsafe code in the app fails the build. The trimmer's whole-app analysis stays quiet, as .NET MAUI
    sets it up for partial trimming: it would report the framework's own warnings (Blazor, see above), not the app's.
    Not on Windows: there the XAML source generator doesn't resolve {OnPlatform} at compile time, and the runtime
    fallback it generates is flagged (fine without trimming).
  -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'windows'">
    <_MauiDoNotConfigureTrimAnalyzer>true</_MauiDoNotConfigureTrimAnalyzer>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
  </PropertyGroup>

  <!--
    Mac Catalyst entitlements. DevFlow needs an in-app HTTP server, which only Debug builds are entitled to.
    App Store builds are signed with a provisioning profile (CodesignProvision), which also allows the keychain access
    group SecureStorage needs; unsigned and ad-hoc signed builds can't carry that entitlement, so they don't get it.
  -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
    <CodesignEntitlements Condition="'$(Configuration)' == 'Debug'">Platforms/MacCatalyst/Entitlements.Debug.plist</CodesignEntitlements>
    <CodesignEntitlements Condition="'$(Configuration)' != 'Debug'">Platforms/MacCatalyst/Entitlements.plist</CodesignEntitlements>
    <CodesignEntitlements Condition="'$(Configuration)' != 'Debug' and '$(CodesignProvision)' != ''">Platforms/MacCatalyst/Entitlements.AppStore.plist</CodesignEntitlements>
    <!--
      Release builds are universal (arm64 and x64), so publishing has no single RuntimeIdentifier. Each architecture
      still gets ReadyToRun; without this the SDK refuses to publish (NETSDK1191).
    -->
    <AllowReadyToRunWithoutRuntimeIdentifier>true</AllowReadyToRunWithoutRuntimeIdentifier>
  </PropertyGroup>

  <!--
    Google Maps API key for the Map sample on Android. Never commit it: pass it at build time with
    -p:MapsApiKey=... or a MapsApiKey environment variable (CI reads the MAPS_API_KEY secret). Without a key the
    Map page explains that this build has none instead of showing an empty grey map.
  -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <AndroidManifestPlaceholders>mapsApiKey=$(MapsApiKey)</AndroidManifestPlaceholders>
  </PropertyGroup>

  <!--
    Azure Maps key for the Map sample on Windows, where .NET MAUI Maps uses WinUI's MapControl. Same rules as above:
    pass it with -p:AzureMapsKey=... or an AzureMapsKey environment variable (CI reads the AZURE_MAPS_KEY secret).
    It's compiled into the app as assembly metadata, and MediaSamples registers it with UseMapServiceToken.
  -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' And '$(AzureMapsKey)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>AzureMapsKey</_Parameter1>
      <_Parameter2>$(AzureMapsKey)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Android edge-to-edge: let the Shell's app bar color fill the status bar area (opt-in in .NET 11). -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <RuntimeHostConfigurationOption Include="Microsoft.Maui.RuntimeFeature.UseMauiAndroidSystemBarBackgrounds" Value="true" Trim="true" />
  </ItemGroup>

  <ItemGroup>
    <!-- The white foreground doubles as Android's monochrome (themed) icon. -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#4F46E5" />
    <!-- The splash uses the app's background color (ColorBackground), so launch flows into the first page. -->
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#F6F5FA" BaseSize="128,128" />
    <MauiImage Include="Resources\Images\*" />
    <MauiFont Include="Resources\Fonts\*" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    Dark launch screen on Android only: on iOS, MAUI 11's dark splash variant leaves the launch screen without its
    image in both themes, so iOS keeps the light one.
  -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <MauiSplashScreen Update="Resources\Splash\splash.svg" DarkColor="#0E0C13" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Code snippets shown next to each sample. File names must be unique across the app.
      WithCulture=false stops MSBuild from reading ".cs" in "Name.cs.txt" as the Czech culture.
    -->
    <EmbeddedResource Include="Features\**\*.xaml.txt;Features\**\*.cs.txt" LogicalName="%(Filename)%(Extension)" WithCulture="false" />
    <!-- The Image page loads this picture with ImageSource.FromStream. -->
    <EmbeddedResource Include="Features\Media\Image\Assets\night_sky.png" LogicalName="MauiGallery.Images.night_sky.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" />
    <PackageReference Include="Microsoft.Maui.Controls.Foldable" />
    <PackageReference Include="Microsoft.Maui.Controls.Maps" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="IconFont.Maui.FluentIcons" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    <PackageReference Include="Microsoft.Maui.DevFlow.Agent" />
    <PackageReference Include="Microsoft.Maui.DevFlow.Blazor" />
  </ItemGroup>

  <!--
    The Windows library in Microsoft.Maui.DevFlow.Blazor lists wwwroot\chobitsu.js in its PRI index, but the package
    ships that file as a static web asset instead, so copying the PRI payload fails with MSB3030. Skip payload files
    that don't exist (Debug only; Release builds don't reference DevFlow).
  -->
  <Target Name="SkipMissingDevFlowPriPayload"
          AfterTargets="AddPriPayloadFilesToCopyToOutputDirectoryItems"
          Condition="'$(Configuration)' == 'Debug' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <ItemGroup>
      <_AllChildProjectItemsWithTargetPath Remove="@(_AllChildProjectItemsWithTargetPath)"
                                           Condition="$([System.String]::Copy('%(FullPath)').Contains('microsoft.maui.devflow')) and !Exists('%(FullPath)')" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\MauiGallery.Core\MauiGallery.Core.csproj" />
  </ItemGroup>

</Project>

<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later: the same rule as auto_backup_rules.xml, for cloud backup and device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="com.jfversluis.mauigallery.microsoft.maui.essentials.preferences.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="com.jfversluis.mauigallery.microsoft.maui.essentials.preferences.xml" />
    </device-transfer>
</data-extraction-rules>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>UIDeviceFamily</key>
	<array>
		<integer>2</integer>
	</array>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.developer-tools</string>
	<!-- The app only uses the encryption built into the OS (HTTPS, Keychain), which is exempt from export rules. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.jfversluis.mauigallery</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>mauigallery</string>
			</array>
		</dict>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>__MAUI_DEFAULT_SCENE_CONFIGURATION__</string>
					<key>UISceneDelegateClassName</key>
					<string>SceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<!-- Lets the Launcher sample check whether an app handles these links (CanOpenAsync). -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>mailto</string>
		<string>tel</string>
		<string>sms</string>
	</array>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>The Geolocation, Geocoding and Map samples show your location on screen. It stays on your device: the gallery doesn't store it, and only sends it to the system's address lookup when you ask for your address.</string>
	<key>NSCameraUsageDescription</key>
	<string>The Media picker sample takes a photo or video when you ask it to, and shows it on screen. Nothing is stored or sent anywhere.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>The Media picker sample records sound with videos you take, and the Permissions sample shows how to ask for microphone access. Nothing is recorded otherwise, stored or sent anywhere.</string>
	<key>NSMotionUsageDescription</key>
	<string>The Sensors sample reads the barometer to show the air pressure on screen. Readings stay on your device and are never stored or sent.</string>
	<key>XSAppIconAssets</key>
	<string>Assets.xcassets/appicon.appiconset</string>
</dict>
</plist>
